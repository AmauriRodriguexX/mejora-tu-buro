# Plantilla de configuración local para la propuesta gráfica.
# Copia este archivo como .env en tu entorno local y completa solo lo necesario.
# Nunca subas .env al repositorio ni pegues aquí contraseñas, tokens o llaves privadas.

PROJECT_NAME=mejora-tu-buro
PROJECT_CLIENT=Baui_Solutions
PROJECT_SITE_URL=https://mejoraburo.com.mx/
PROJECT_SOURCE_REPO=https://github.com/AmauriRodriguexX/mejora-tu-buro.git

# Identidad visual de referencia para prototipos y propuestas.
BRAND_PRIMARY_TEAL=#30afb8
BRAND_CYAN=#42bce2
BRAND_SLATE=#313b48
BRAND_PURPLE=#8154f0
BRAND_NAVY=#00386e
BRAND_RED=#dc3232

# Directorios de trabajo locales (no son secretos).
EVIDENCE_DIR=./evidencia
DELIVERABLES_DIR=./entrega-final
